{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/cleanup-tmp.sh\"",
            "timeout": 30,
            "statusMessage": "Maintaining project scratch space"
          }
        ]
      }
    ]
  }
}

